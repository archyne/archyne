{
  "name": "archyne",
  "displayName": "Archyne — visual editor for Mermaid",
  "description": "Edit Mermaid diagrams on a canvas, with two-way sync to the text — in a .mmd file, or in a ```mermaid block inside your Markdown. The file stays ordinary, and VS Code keeps owning it.",
  "version": "1.1.1",
  "publisher": "naxeris",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f1014",
    "theme": "dark"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "mermaid",
    "diagram",
    "flowchart",
    "uml",
    "sequence-diagram",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archyne/archyne.git",
    "directory": "extensions/vscode"
  },
  "bugs": {
    "url": "https://github.com/archyne/archyne/issues"
  },
  "homepage": "https://github.com/archyne/archyne/tree/main/extensions/vscode",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:mdx",
    "onLanguage:mermaid"
  ],
  "contributes": {
    "configuration": {
      "title": "Archyne",
      "properties": {
        "archyne.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show an \"Open on canvas\" action above Mermaid code blocks in Markdown files."
        }
      }
    },
    "languages": [
      {
        "id": "mermaid",
        "aliases": [
          "Mermaid"
        ],
        "extensions": [
          ".mmd",
          ".mermaid"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "archyne.editor",
        "displayName": "Archyne",
        "selector": [
          {
            "filenamePattern": "*.mmd"
          },
          {
            "filenamePattern": "*.mermaid"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "archyne.open",
        "title": "Open on the canvas",
        "category": "Archyne"
      },
      {
        "command": "archyne.openFence",
        "title": "Open the Mermaid block at the cursor on the canvas",
        "category": "Archyne"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "archyne.open",
          "when": "resourceExtname == .mmd || resourceExtname == .mermaid"
        },
        {
          "command": "archyne.openFence",
          "when": "editorLangId == markdown || editorLangId == mdx"
        }
      ],
      "editor/title": [
        {
          "command": "archyne.open",
          "when": "resourceExtname == .mmd || resourceExtname == .mermaid",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "bundle": "node scripts/bundle-app.mjs",
    "compile": "tsc -p .",
    "build": "npm run version:sync && npm run bundle && npm run compile",
    "typecheck": "tsc -p . --noEmit",
    "package": "npm run build && vsce package --out archyne.vsix"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0",
    "ovsx": "^1.1.1",
    "typescript": "~5.8.0"
  }
}
