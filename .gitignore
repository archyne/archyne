node_modules
dist
# The host half of Generate, built by `npm run build:host` (vite.host.config.ts).
dist-host
*.local
*.tsbuildinfo
release
sbom.json

# Built into the VS Code extension: its compiled output, the copy of the app
# it packages, and the package itself. All three are produced by
# `extensions/vscode` → `npm run build`.
extensions/*/out
extensions/*/media/app
extensions/*/media/host
extensions/*/*.vsix

# Output of the browser-driven e2e scripts (tests/e2e-*.mts). They write their
# renders beside the project so a failure can be looked at; none of it belongs
# in history.
export-e2e*.png
export-e2e*.pdf
import-e2e*.png
e2e-out
*-server.log

# Personal working notes: kept beside the project, never published
*.local.md

# Copied from the repository root by `packages/render/scripts/build.mjs` so the
# tarball carries it. Generated rather than kept, so that the package's licence
# cannot drift from the project's.
packages/render/LICENSE

# Browser profile of tests/smoke-ai-local.mts: it caches the model weights so a
# rerun skips a download of several hundred megabytes. Local only.
.smoke-profile
